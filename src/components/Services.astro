---
const services = [
    {
        title: 'Cloud Security & Vulnerability Management',
        description: 'Runtime and open-source vulnerability scanning, security tooling, and defensible pipelines for cloud-native platforms.',
    },
    {
        title: 'GitOps & Infrastructure as Code',
        description: 'Reproducible, audit-friendly deployments on Kubernetes with Flux, Helm, Kustomize, and Terraform.',
    },
    {
        title: 'Event-Driven Microservices',
        description: 'High-throughput services on Kubernetes with Kafka streaming and caching tiers built for scale and low latency.',
    },
    {
        title: 'Cloud Architecture',
        description: 'Resilient system design and infrastructure on AWS, SAP BTP, and Gardener — from prototype to production.',
    },
];
---
<section id="services" class="scroll-mt-20 border-t border-[var(--border-color)] py-20">
    <h2 class="mb-4 text-sm font-medium uppercase tracking-widest text-[var(--accent)]">What I build for clients</h2>
    <p class="mb-10 max-w-2xl text-lg text-[var(--text-secondary)]">
        Need help shipping something secure and scalable? These are the areas I work in.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
        {services.map((service) => (
            <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-6 transition-colors hover:border-[var(--accent)]">
                <h3 class="mb-2 text-lg font-semibold text-[var(--text-primary)]">{service.title}</h3>
                <p class="text-[var(--text-secondary)]">{service.description}</p>
            </div>
        ))}
    </div>
</section>
